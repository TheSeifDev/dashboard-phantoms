# =========================================================================
# PHANTOMS Platform — Comprehensive Security .gitignore Policy
# =========================================================================

# --- 1. Environment & Secrets (Deny by default across all workspaces) ---
**/.env
**/.env.*
!**/.env.example
!**/.env.template
!**/.env.sample

# Local overrides
*.local
*.local.*

# Secret & credential directories
**/secrets/
**/credentials/
**/*service-account*.json
**/credentials*.json

# Private keys, certificates & keystores
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Platform temporary / secret cache
**/.vercel/
**/.supabase/.temp/

# WhatsApp Bridge local session storage
backend/whatsapp-bridge/data/

# --- 2. Dependencies & Package Managers ---
node_modules/
.pnpm-store/

# --- 3. Build & Distribution Artifacts ---
dist/
dist-ssr/
build/
outputs/
.work/
.manus/
*.apk
*.aab

# --- 4. Logs & Diagnostics ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- 5. Editor & Agent Directories ---
.playwright-mcp/
.claude/
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
