{
  "name": "@phantoms/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run ux:guard && vite build",
    "lint": "oxlint",
    "ux:guard": "node scripts/ux-guard.mjs",
    "ux:audit": "node scripts/ux-audit.mjs",
    "preview": "vite preview",
    "health": "node scripts/phantoms-health-check.mjs",
    "health:json": "node scripts/phantoms-health-check.mjs --json",
    "db:audit": "node scripts/phantoms-db-audit.mjs",
    "db:clean": "node scripts/phantoms-db-audit.mjs --clean-subscriptions",
    "deploy": "node scripts/phantoms-deploy.mjs",
    "deploy:prod": "node scripts/phantoms-deploy.mjs --prod",
    "deploy:dry": "node scripts/phantoms-deploy.mjs --dry-run",
    "vapid:gen": "node scripts/phantoms-generate-vapid.mjs",
    "vapid:print": "node scripts/phantoms-generate-vapid.mjs --print-only",
    "migrate:check": "node scripts/run-migrations.mjs --check",
    "migrate:print": "node scripts/run-migrations.mjs --print",
    "test:security": "node --test scripts/security-regression.mjs",
    "test:runtime": "node --test scripts/security-runtime-integration.mjs",
    "test:xlsx": "npx tsx --test scripts/safe-xlsx-test.ts",
    "test:brand": "node --test scripts/brand-transition-test.mjs",
    "test:storage": "npx tsx --test scripts/test-storage-migration.ts",
    "audit:identity": "node scripts/audit-legacy-identity.mjs",
    "apk:sync": "npm run build && npx cap sync android",
    "apk": "node scripts/build-apk.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.48.0",
    "qrcode.react": "4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
